@model BookStoreApplication.MVC.DTOs.Author.AuthorRequestDTO
@{ ViewData["Title"] = "Add Author"; }
<section class="page-hero"><div class="position-relative"><h1>Add author.</h1><p>Create a clean author profile for catalog browsing.</p></div></section>
<div class="form-card"><form method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label asp-for="FirstName" class="form-label">First name</label><input asp-for="FirstName" class="form-control" /></div><div class="col-md-6"><label asp-for="LastName" class="form-label">Last name</label><input asp-for="LastName" class="form-control" /></div><div class="col-12"><label asp-for="Photo" class="form-label">Photo URL</label><input asp-for="Photo" class="form-control" placeholder="/images/authors/name.jpg" /></div><div class="col-12"><button class="btn btn-primary">Save Author</button> <a asp-action="Index" class="btn btn-soft">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
