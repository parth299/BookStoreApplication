@model BookStoreApplication.MVC.DTOs.Book_Publisher.BookCreateDto
@{ ViewData["Title"] = "Add Book"; }
<section class="page-hero"><div class="position-relative"><h1>Add a new book.</h1><p>Use dropdowns for category and publisher so users do not have to type related IDs manually.</p></div></section>
<div class="form-card">
<form asp-action="Create" method="post" class="row g-3">
    <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-4"></div>
    <div class="col-md-6"><label asp-for="Isbn" class="form-label">ISBN</label><input asp-for="Isbn" class="form-control" placeholder="9780132350884" /></div>
    <div class="col-md-6"><label asp-for="Title" class="form-label">Title</label><input asp-for="Title" class="form-control" placeholder="Book title" /></div>
    <div class="col-md-6"><label asp-for="Category" class="form-label">Category</label><select asp-for="Category" asp-items="ViewBag.Categories" class="form-select"><option value="">Select category</option></select></div>
    <div class="col-md-6"><label asp-for="PublisherId" class="form-label">Publisher</label><select asp-for="PublisherId" asp-items="ViewBag.Publishers" class="form-select"><option value="">Select publisher</option></select></div>
    <div class="col-md-6"><label asp-for="Edition" class="form-label">Edition</label><input asp-for="Edition" class="form-control" placeholder="1st, 2nd, Collector" /></div>
    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" rows="5" class="form-control" placeholder="Short professional book description"></textarea></div>
    <div class="col-12 d-flex gap-2"><button class="btn btn-primary">Save Book</button><a asp-action="Index" class="btn btn-soft">Cancel</a></div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
