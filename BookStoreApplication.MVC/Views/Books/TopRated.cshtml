@model IEnumerable<BookStoreApplication.MVC.DTOs.Book_Publisher.BookTopRatedDto>
@{
    ViewData["Title"] = "Top Rated";
    var items = Model?.ToList() ?? new List<BookStoreApplication.MVC.DTOs.Book_Publisher.BookTopRatedDto>();
}
<section class="page-hero"><div class="position-relative"><h1>Top rated books.</h1><p>Ranking based on API review averages.</p></div></section>
<div class="table-card">
<table class="table"><thead><tr><th>Rank</th><th>Book</th><th>Average</th><th>Reviews</th><th></th></tr></thead><tbody>
@for (var i = 0; i < items.Count; i++)
{
    <tr><td><span class="badge text-bg-warning">#@(i+1)</span></td><td><strong>@items[i].Title</strong><br/><small class="text-muted">@items[i].Isbn</small></td><td><span class="rating-stars">★★★★★</span> @items[i].AverageRating.ToString("0.0")</td><td>@items[i].ReviewCount</td><td><a asp-action="Details" asp-route-id="@items[i].Isbn" class="btn btn-soft btn-sm">Open</a></td></tr>
}
</tbody></table>
</div>
