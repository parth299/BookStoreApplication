@model BookStoreApplication.MVC.DTOs.Book_Publisher.BookResponseDto
@{
    ViewData["Title"] = Model.Title;
}
<section class="page-hero">
    <div class="position-relative">
        <span class="badge rounded-pill text-bg-light text-primary px-3 py-2 mb-3">ISBN @Model.Isbn</span>
        <h1>@Model.Title</h1>
        <p>@(Model.Description ?? "No description available.")</p>
        <div class="hero-actions">
            <a asp-action="Edit" asp-route-id="@Model.Isbn" class="btn btn-light rounded-pill px-4">Edit Book</a>
            <a asp-controller="Reviews" asp-action="Book" asp-route-isbn="@Model.Isbn" class="btn btn-outline-light rounded-pill px-4">View Reviews</a>
            <a asp-controller="Reviews" asp-action="Create" class="btn btn-outline-light rounded-pill px-4">Write Review</a>
        </div>
    </div>
</section>
<div class="row g-4">
    <div class="col-lg-5"><div class="pro-card book-card"><div class="book-cover" style="min-height:420px"><h3>@Model.Title</h3><small>@(Model.PublisherName ?? "BookVerse")</small></div></div></div>
    <div class="col-lg-7">
        <div class="table-card">
            <table class="table"><tbody>
                <tr><th>ISBN</th><td>@Model.Isbn</td></tr>
                <tr><th>Category</th><td>@Model.Category</td></tr>
                <tr><th>Edition</th><td>@(Model.Edition ?? "Standard")</td></tr>
                <tr><th>Publisher</th><td>@(Model.PublisherName ?? Model.PublisherId.ToString())</td></tr>
                <tr><th>Description</th><td>@(Model.Description ?? "No description available.")</td></tr>
            </tbody></table>
        </div>
    </div>
</div>
