@model IEnumerable<BookStoreApplication.MVC.DTOs.Book_Publisher.PublisherResponseDto>
@{ ViewData["Title"]="Publishers"; var items = Model?.ToList() ?? new List<BookStoreApplication.MVC.DTOs.Book_Publisher.PublisherResponseDto>(); }
<section class="page-hero"><div class="position-relative d-flex justify-content-between align-items-end flex-wrap gap-3"><div><h1>Publishers.</h1><p>Maintain publisher data used by book forms and catalogue pages.</p></div><a asp-action="Create" class="btn btn-light rounded-pill px-4">Add Publisher</a></div></section>
<div class="pro-card mb-4"><form method="get" class="row g-3"><div class="col-md-10"><input name="name" class="form-control" placeholder="Search publisher by name"/></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Search</button></div></form></div>
<div class="table-card"><table class="table"><thead><tr><th>Publisher</th><th>Location</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var p in items){<tr><td><strong>@p.Name</strong><br/><small class="text-muted">ID @p.PublisherId</small></td><td>@p.City @p.StateCode</td><td class="text-end"><a asp-action="Details" asp-route-id="@p.PublisherId" class="btn btn-soft btn-sm">Details</a> <a asp-action="Edit" asp-route-id="@p.PublisherId" class="btn btn-primary btn-sm">Edit</a></td></tr>}</tbody></table></div>
