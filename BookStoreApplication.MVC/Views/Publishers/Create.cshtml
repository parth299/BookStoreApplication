@model BookStoreApplication.MVC.DTOs.Book_Publisher.PublisherCreateDto
@{ ViewData["Title"]="Add Publisher"; }
<section class="page-hero"><div class="position-relative"><h1>Add publisher.</h1><p>Publisher data becomes available in book dropdowns.</p></div></section>
<div class="form-card"><form method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="col-md-4"><label asp-for="PublisherId" class="form-label">Publisher ID</label><input asp-for="PublisherId" class="form-control"/></div><div class="col-md-8"><label asp-for="Name" class="form-label">Name</label><input asp-for="Name" class="form-control"/></div><div class="col-md-6"><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control"/></div><div class="col-md-6"><label asp-for="StateCode" class="form-label">State Code</label><input asp-for="StateCode" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Save Publisher</button> <a asp-action="Index" class="btn btn-soft">Cancel</a></div></form></div>
