@model UpdateReviewRequestDto
@{
    ViewData["Title"] = "Edit Review";
}

<h2>Edit Review</h2>
<p><strong>ISBN:</strong> @ViewBag.Isbn | <strong>Reviewer ID:</strong> @ViewBag.ReviewerId</p>

<form asp-action="Edit" asp-route-isbn="@ViewBag.Isbn" asp-route-reviewerId="@ViewBag.ReviewerId" method="post" class="card p-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Rating" class="form-label"></label>
        <input asp-for="Rating" class="form-control" min="1" max="10" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Comments" class="form-label"></label>
        <textarea asp-for="Comments" class="form-control" rows="4" maxlength="255"></textarea>
        <span asp-validation-for="Comments" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
