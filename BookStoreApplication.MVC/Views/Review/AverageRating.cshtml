@model BookAverageRatingDto?
@{
    ViewData["Title"] = "Average Rating";
}
<h2>Average Rating</h2>
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning">@ViewBag.ErrorMessage</div>
}
else if (Model != null)
{
    <div class="card p-4">
        <p><strong>ISBN:</strong> @Model.Isbn</p>
        <p><strong>Average Rating:</strong> @Model.AverageRating</p>
        <p><strong>Review Count:</strong> @Model.ReviewCount</p>
    </div>
}
