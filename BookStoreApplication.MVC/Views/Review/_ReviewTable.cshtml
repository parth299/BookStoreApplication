@model List<BookReviewDto>
<table class="table table-striped table-bordered bg-white">
    <thead>
        <tr><th>ISBN</th><th>Reviewer ID</th><th>Reviewer</th><th>Employed By</th><th>Rating</th><th>Comments</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Isbn</td><td>@item.ReviewerId</td><td>@item.ReviewerName</td><td>@item.EmployedBy</td><td>@item.Rating</td><td>@item.Comments</td>
            <td><a asp-action="Edit" asp-route-isbn="@item.Isbn" asp-route-reviewerId="@item.ReviewerId" asp-route-rating="@item.Rating" asp-route-comments="@item.Comments">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
