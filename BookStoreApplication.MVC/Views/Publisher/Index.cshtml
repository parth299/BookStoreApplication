@model PublisherIndexViewModel
@{
    ViewData["Title"] = "Publishers";
}

<section class="catalog-heading">
    <div>
        <p class="catalog-kicker">Catalog Management</p>
        <h1>Publishers</h1>
    </div>
    @if (Model.CanManageCatalog)
    {
        <a class="catalog-button catalog-button--primary" asp-action="Create">Add Publisher</a>
    }
</section>

@if (TempData["CatalogMessage"] is string message)
{
    <div class="catalog-alert catalog-alert--success">@message</div>
}

<form asp-action="Index" method="get" class="catalog-search catalog-search--spaced">
    <input name="name" value="@Model.SearchName" class="form-input" placeholder="Search publisher by name" />
    <button class="catalog-button catalog-button--ghost" type="submit">Search</button>
    <a class="catalog-link" asp-action="Index">Clear</a>
</form>

@if (Model.Publishers.Count == 0)
{
    <div class="empty-state">No publishers found.</div>
}
else
{
    <div class="publisher-table">
        <table class="catalog-table">
            <thead>
                <tr>
                    <th>Publisher</th>
                    <th>Location</th>
                    <th class="cell-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var publisher in Model.Publishers)
            {
                <tr>
                    <td>
                        <strong>@publisher.Name</strong>
                    </td>
                    <td>@(string.Join(", ", new[] { publisher.City}.Where(x => !string.IsNullOrWhiteSpace(x))))</td>
                    <td class="cell-actions">
                        @if (Model.CanManageCatalog)
                        {
                            <a class="catalog-button catalog-button--small catalog-button--ghost" asp-action="Edit" asp-route-id="@publisher.PublisherId">Edit</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
