@model PublisherFormViewModel
@{
    ViewData["Title"] = "Edit Publisher";
}

<section class="catalog-heading">
    <div>
        <p class="catalog-kicker">Admin / StoreOwner</p>
        <h1>Edit Publisher</h1>
    </div>
    <a class="catalog-button catalog-button--ghost" asp-action="Index">Back</a>
</section>

<form asp-action="Edit" asp-route-id="@Model.PublisherId" method="post" class="catalog-form">
    <div asp-validation-summary="ModelOnly" class="validation-message"></div>
    <input asp-for="PublisherId" type="hidden" />
    <div class="form-grid">
        <div class="field-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-input" />
            <span asp-validation-for="Name" class="validation-message"></span>
        </div>
        <div class="field-group">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-input" />
            <span asp-validation-for="City" class="validation-message"></span>
        </div>
        <div class="field-group">
            <label asp-for="StateCode" class="form-label">State Code</label>
            <input asp-for="StateCode" class="form-input" maxlength="2" />
            <span asp-validation-for="StateCode" class="validation-message"></span>
        </div>
    </div>
    <div class="catalog-actions catalog-actions--spaced">
        <button class="catalog-button catalog-button--primary" type="submit">Save Publisher</button>
        <a class="catalog-button catalog-button--ghost" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
