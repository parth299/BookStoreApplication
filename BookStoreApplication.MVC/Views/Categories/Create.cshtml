@model BookStoreApplication.MVC.DTOs.Category.CategoryRequestDto
@{ ViewData["Title"]="Add Category"; }
<section class="page-hero"><div class="position-relative"><h1>Add category.</h1><p>Create simple category labels for book dropdowns.</p></div></section>
<div class="form-card"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label asp-for="CatDescription" class="form-label">Category name</label><input asp-for="CatDescription" class="form-control mb-3" placeholder="Programming, Fiction, Business"/><button class="btn btn-primary">Save Category</button> <a asp-action="Index" class="btn btn-soft">Cancel</a></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
