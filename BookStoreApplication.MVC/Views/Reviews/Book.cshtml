@model object
@{
    ViewData["Title"] = "Book Reviews";
}

<h1>Reviews for @ViewBag.Isbn</h1>

<div class="mb-3 d-flex gap-2">
    <a class="btn btn-primary" asp-action="Create" asp-route-isbn="@ViewBag.Isbn">Add Review</a>
    <a class="btn btn-outline-secondary" asp-controller="BookRatings" asp-action="Index">Check Average Rating</a>
    <a class="btn btn-outline-secondary" asp-action="Index">All Reviews</a>
</div>

@await Html.PartialAsync("_ObjectTable", Model)
