@model IEnumerable<BookStoreApplication.MVC.DTOs.ReviewsAndRatings.BookReviewDto>
@{ ViewData["Title"]="Reviewer Reviews"; var items = Model?.ToList() ?? new List<BookStoreApplication.MVC.DTOs.ReviewsAndRatings.BookReviewDto>(); }
<section class="page-hero"><div class="position-relative"><h1>Reviewer @ViewBag.ReviewerId</h1><p>All reviews written by this reviewer.</p></div></section>
<div class="row g-4">@foreach(var r in items){<div class="col-md-6"><div class="pro-card"><div class="rating-stars mb-2">@(new string('★', Math.Max(1, r.Rating ?? 1)))</div><h4>@r.Isbn</h4><p class="text-muted">@r.Comments</p></div></div>}</div>
