@model BookStoreApplication.MVC.DTOs.ReviewsAndRatings.CreateReviewRequestDto
@{ ViewData["Title"]="Write Review"; }
<section class="page-hero"><div class="position-relative"><span class="badge rounded-pill text-bg-light text-primary px-3 py-2 mb-3">Guest allowed</span><h1>Write a book review.</h1><p>No login is required. Select the book, enter reviewer details, choose a rating, and submit.</p></div></section>
<div class="form-card">
<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col-md-12"><label asp-for="Isbn" class="form-label">Book</label><select asp-for="Isbn" asp-items="ViewBag.Books" class="form-select"><option value="">Select book</option></select></div>
    <div class="col-md-4"><label asp-for="ReviewerId" class="form-label">Reviewer ID</label><input asp-for="ReviewerId" class="form-control" placeholder="101" /></div>
    <div class="col-md-4"><label asp-for="Name" class="form-label">Your name</label><input asp-for="Name" class="form-control" placeholder="Jane Reader" /></div>
    <div class="col-md-4"><label asp-for="EmployedBy" class="form-label">Organization</label><input asp-for="EmployedBy" class="form-control" placeholder="Optional" /></div>
    <div class="col-md-4"><label asp-for="Rating" class="form-label">Rating</label><select asp-for="Rating" class="form-select"><option value="5">★★★★★ Excellent</option><option value="4">★★★★ Good</option><option value="3">★★★ Average</option><option value="2">★★ Poor</option><option value="1">★ Bad</option></select></div>
    <div class="col-md-8"><label asp-for="Comments" class="form-label">Comments</label><textarea asp-for="Comments" rows="4" class="form-control" placeholder="Share your experience with the book"></textarea></div>
    <div class="col-12 d-flex gap-2"><button class="btn btn-primary">Submit Review</button><a asp-action="Index" class="btn btn-soft">Cancel</a></div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
