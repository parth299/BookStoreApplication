@model BookStoreApplication.MVC.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5 animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-card">
                <div class="text-center mb-4">
                    <div class="position-relative d-inline-block">
                        <img src="https://ui-avatars.com/api/?name=@Model.FirstName+@Model.LastName&background=6366f1&color=fff&size=128" class="profile-img mb-3" alt="Profile" />
                    </div>
                    <h2 class="page-header mb-1">@Model.FirstName @Model.LastName</h2>
                    <span class="badge bg-primary px-3 py-2 rounded-pill">@Model.RoleName</span>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Profile" asp-route-id="@Model.UserId" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserId" class="form-label text-secondary small fw-bold">User ID</label>
                        <input asp-for="UserId" class="form-control bg-light" readonly />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label text-secondary small fw-bold"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label text-secondary small fw-bold"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label text-secondary small fw-bold"></label>
                        <input asp-for="UserName" class="form-control" readonly />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                        <div class="form-text">Username cannot be changed.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label text-secondary small fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="submit" class="btn btn-primary px-4">Update Profile</button>
                        <a asp-action="Logout" class="text-danger fw-bold text-decoration-none">Sign Out</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
