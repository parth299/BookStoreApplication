@model BookStoreApplication.MVC.DTOs.User.LoginUserDTO
@{ ViewData["Title"] = "Login"; }
<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-art">
            <div><span class="badge text-bg-light text-primary rounded-pill px-3 py-2 mb-3">Secure access</span><h1>Welcome back to BookVerse.</h1><p class="text-white-50">Login through the Web API. After login, roles are read from the JWT and admin links appear automatically.</p></div>
            <div class="footer-note text-white-50">MVC Cookie Auth + API JWT token storage</div>
        </div>
        <div class="auth-form">
            <h2 class="fw-black mb-1">Login</h2><p class="text-muted mb-4">Enter your account credentials.</p>
            <form method="post" class="vstack gap-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger"></div>
                <div><label asp-for="UserName" class="form-label">Username</label><input asp-for="UserName" class="form-control" placeholder="testuser" /></div>
                <div><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" placeholder="••••••••" /></div>
                <button class="btn btn-primary btn-lg w-100">Login</button>
                <p class="text-muted text-center mb-0">New here? <a asp-action="Register">Create an account</a></p>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
