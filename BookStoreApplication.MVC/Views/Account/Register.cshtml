@model BookStoreApplication.MVC.DTOs.User.RegisterUserDTO
@{ ViewData["Title"] = "Create Account"; }

<div class="auth-wrap">
    <div class="auth-card luxury-auth">
        <div class="auth-art">
            <div>
                <span class="badge rounded-pill bg-gold-soft text-dark px-3 py-2 mb-3">Reader Access</span>
                <h1>Start your bookstore journey.</h1>
                <p class="text-white-50">Create a reader account for browsing, cart access, and purchases. Roles are managed only by the backend/admin team.</p>
            </div>
            <div class="auth-mini-card">
                <strong>Default role</strong>
                <span>User</span>
            </div>
        </div>
        <div class="auth-form">
            <div class="mb-4">
                <div class="tiny-label text-primary">SIGN UP</div>
                <h2 class="fw-black mb-1">Create account</h2>
                <p class="text-muted mb-0">No role selection is shown to public users.</p>
            </div>
            <form method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="RoleNumber" type="hidden" value="1" />

                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label">First name</label>
                    <input asp-for="FirstName" class="form-control" placeholder="John" />
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label">Last name</label>
                    <input asp-for="LastName" class="form-control" placeholder="Reader" />
                </div>
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label">Username</label>
                    <input asp-for="UserName" class="form-control" placeholder="johnreader" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Phone</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="9876543210" />
                </div>
                <div class="col-12">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create a secure password" />
                </div>
                <div class="col-12 d-grid mt-2">
                    <button class="btn btn-primary btn-lg">Create User Account</button>
                </div>
                <div class="col-12 text-center">
                    <span class="text-muted small">Already registered?</span>
                    <a asp-action="Login" class="small fw-bold">Login here</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
