@model IEnumerable<BookStoreApplication.MVC.DTOs.Inventory.InventoryDto>
@{ ViewData["Title"]="Inventory"; var items = Model?.ToList() ?? new List<BookStoreApplication.MVC.DTOs.Inventory.InventoryDto>(); }
<section class="page-hero"><div class="position-relative d-flex justify-content-between align-items-end flex-wrap gap-3"><div><h1>Inventory control.</h1><p>Track available and purchased copies using book dropdowns.</p></div><div class="hero-actions"><a asp-action="LowStock" class="btn btn-outline-light rounded-pill px-4">Low Stock</a><a asp-action="Available" class="btn btn-outline-light rounded-pill px-4">Available</a><a asp-action="Create" class="btn btn-light rounded-pill px-4">Add Inventory</a></div></div></section>
<div class="pro-card mb-4"><form method="get" class="row g-3 align-items-end"><div class="col-md-10"><label class="form-label">Book</label><select name="isbn" asp-items="ViewBag.Books" class="form-select"><option value="">All books</option></select></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Filter</button></div></form></div>
<div class="table-card"><table class="table"><thead><tr><th>Inventory</th><th>Book ISBN</th><th>Condition</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var i in items){<tr><td><strong>#@i.InventoryId</strong></td><td>@i.ISBN</td><td><span class="badge status-info">Condition @i.ConditionRank</span></td><td>@if(i.Purchased == 1){<span class="badge status-purchased">Purchased</span>}else{<span class="badge status-available">Available</span>}</td><td class="text-end"><a asp-action="Edit" asp-route-id="@i.InventoryId" class="btn btn-primary btn-sm">Edit</a></td></tr>}</tbody></table></div>
