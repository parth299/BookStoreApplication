@model BookStoreApplication.MVC.DTOs.Inventory.CreateInventoryDto
@{ ViewData["Title"]="Add Inventory"; }
<section class="page-hero"><div class="position-relative"><h1>Add inventory.</h1><p>Select the book and condition instead of typing raw data.</p></div></section>
<div class="form-card"><form method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label asp-for="ISBN" class="form-label">Book</label><select asp-for="ISBN" asp-items="ViewBag.Books" class="form-select"><option value="">Select book</option></select></div><div class="col-md-3"><label asp-for="ConditionRank" class="form-label">Condition</label><select asp-for="ConditionRank" asp-items="ViewBag.Conditions" class="form-select"></select></div><div class="col-md-3"><label asp-for="Purchased" class="form-label">Status</label><select asp-for="Purchased" asp-items="ViewBag.PurchasedOptions" class="form-select"></select></div><div class="col-12"><button class="btn btn-primary">Save Inventory</button> <a asp-action="Index" class="btn btn-soft">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
