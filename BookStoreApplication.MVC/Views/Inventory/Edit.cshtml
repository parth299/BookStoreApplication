@model BookStoreApplication.MVC.DTOs.Inventory.InventoryDto
@{ ViewData["Title"]="Edit Inventory"; }
<section class="page-hero"><div class="position-relative"><h1>Edit inventory.</h1><p>Update copy condition and purchase status.</p></div></section>
<div class="form-card"><form method="post" class="row g-3">@Html.AntiForgeryToken()<input type="hidden" asp-for="InventoryId"/><div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label asp-for="ISBN" class="form-label">ISBN</label><input asp-for="ISBN" class="form-control" readonly/></div><div class="col-md-3"><label asp-for="ConditionRank" class="form-label">Condition</label><select asp-for="ConditionRank" asp-items="ViewBag.Conditions" class="form-select"></select></div><div class="col-md-3"><label asp-for="Purchased" class="form-label">Status</label><select asp-for="Purchased" asp-items="ViewBag.PurchasedOptions" class="form-select"></select></div><div class="col-12"><button class="btn btn-primary">Update Inventory</button> <a asp-action="Index" class="btn btn-soft">Cancel</a></div></form></div>
