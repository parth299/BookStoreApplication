@model AuthorResponseDTO
@{
    ViewData["Title"] = Model == null ? "Author Detail" : $"{Model.FirstName} {Model.LastName}";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Authors</a></li>
        <li class="breadcrumb-item active">@Model?.FirstName @Model?.LastName</li>
    </ol>
</nav>

@if (Model == null)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Author not found.</div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0">
                <!-- Header band -->
                <div class="card-header bg-primary text-white py-4 text-center border-0">
                    @if (!string.IsNullOrEmpty(Model.Photo))
                    {
                        <img src="@Model.Photo" alt="@Model.FirstName @Model.LastName"
                             class="rounded-circle border border-4 border-white mb-3"
                             width="90" height="90" style="object-fit:cover" />
                    }
                    else
                    {
                        <div class="author-avatar-lg mx-auto mb-3">
                            <span>@Model.FirstName[0]@Model.LastName[0]</span>
                        </div>
                    }
                    <h4 class="mb-0 fw-bold">@Model.FirstName @Model.LastName</h4>
                    <small class="opacity-75">Author ID: @Model.AuthorId</small>
                </div>

                <div class="card-body p-4">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th class="text-muted fw-normal ps-0" width="40%">First Name</th>
                            <td class="fw-semibold">@Model.FirstName</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-normal ps-0">Last Name</th>
                            <td class="fw-semibold">@Model.LastName</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-normal ps-0">Author ID</th>
                            <td><span class="badge bg-secondary">@Model.AuthorId</span></td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-normal ps-0">Photo</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.Photo))
                                {
                                    <a href="@Model.Photo" target="_blank" class="text-truncate d-block" style="max-width:220px">
                                        <i class="bi bi-image me-1"></i>View photo
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No photo</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="card-footer bg-transparent d-flex gap-2 p-4">
                    <a asp-action="Edit" asp-route-id="@Model.AuthorId"
                       class="btn btn-primary flex-fill">
                        <i class="bi bi-pencil me-1"></i>Edit Author
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<style>
.author-avatar-lg {
    width:90px; height:90px; border-radius:50%;
    background:rgba(255,255,255,.25);
    display:flex; align-items:center; justify-content:center;
    border:4px solid #fff;
}
.author-avatar-lg span { color:#fff; font-size:2rem; font-weight:700; }
</style>
