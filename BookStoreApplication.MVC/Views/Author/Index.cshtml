@model List<AuthorResponseDTO>
@{
    ViewData["Title"] = "Authors";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Authors</h2>
        <small class="text-muted">Manage all authors in the bookstore</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Author
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search Bar -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input id="searchInput" name="search" type="text"
                       class="form-control border-start-0"
                       placeholder="Search by author name…"
                       value="@ViewBag.Search"
                       autocomplete="off" />
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
            <button type="submit" class="btn btn-primary px-4">Search</button>
        </form>
        <!-- Live suggestion dropdown -->
        <div id="suggestions" class="position-relative">
            <ul id="suggestionList"
                class="list-group position-absolute w-100 shadow-sm d-none"
                style="z-index:1050;top:2px"></ul>
        </div>
    </div>
</div>

<!-- Author Grid -->
@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-person-x fs-1 d-block mb-2"></i>
        <p class="mb-0">No authors found. <a asp-action="Create">Add one?</a></p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4" id="authorCards">
        @foreach (var author in Model)
        {
            <div class="col author-card">
                <div class="card h-100 shadow-sm border-0 hover-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <!-- Avatar -->
                        <div class="avatar-circle flex-shrink-0">
                            @if (!string.IsNullOrEmpty(author.Photo))
                            {
                                <img src="@author.Photo" alt="@author.FirstName @author.LastName"
                                     class="rounded-circle" width="56" height="56"
                                     style="object-fit:cover" />
                            }
                            else
                            {
                                <span class="avatar-initials">@author.FirstName[0]@author.LastName[0]</span>
                            }
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="card-title mb-0 text-truncate fw-semibold">@author.FirstName @author.LastName</h6>
                            <small class="text-muted">ID: @author.AuthorId</small>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex gap-2 pb-3 px-3">
                        <a asp-action="Detail" asp-route-id="@author.AuthorId"
                           class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                        <a asp-action="Edit" asp-route-id="@author.AuthorId"
                           class="btn btn-sm btn-outline-secondary flex-fill">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
    <p class="text-muted mt-3 small">Showing <strong>@Model.Count</strong> author(s)</p>
}

@section Scripts {
<script>
    // Live search suggestions via API
    const input = document.getElementById('searchInput');
    const list  = document.getElementById('suggestionList');
    let   timer;

    input?.addEventListener('input', () => {
        clearTimeout(timer);
        const q = input.value.trim();
        if (q.length < 2) { list.classList.add('d-none'); return; }

        timer = setTimeout(async () => {
            try {
                const res  = await fetch(`/Author/SearchJson?name=${encodeURIComponent(q)}`);
                const data = await res.json();
                const hits = data ?? [];

                list.innerHTML = '';
                if (!hits.length) { list.classList.add('d-none'); return; }

                hits.slice(0, 6).forEach(a => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-2';
                    li.innerHTML = `<i class="bi bi-person text-primary"></i>
                                    <span>${a.firstName} ${a.lastName}</span>`;
                    li.onclick = () => {
                        input.value = `${a.firstName} ${a.lastName}`;
                        list.classList.add('d-none');
                        input.form.submit();
                    };
                    list.appendChild(li);
                });
                list.classList.remove('d-none');
            } catch { list.classList.add('d-none'); }
        }, 300);
    });

    document.addEventListener('click', e => {
        if (!list.contains(e.target) && e.target !== input)
            list.classList.add('d-none');
    });
</script>
}

<style>
.hover-card { transition: transform .15s, box-shadow .15s; }
.hover-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important; }
.avatar-circle { width:56px; height:56px; border-radius:50%; background:var(--bs-primary);
                 display:flex; align-items:center; justify-content:center; }
.avatar-initials { color:#fff; font-weight:700; font-size:1.1rem; letter-spacing:.5px; }
</style>
