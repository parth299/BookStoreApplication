@model AuthorRequestDTO
@{
    ViewData["Title"] = "Add Author";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Authors</a></li>
        <li class="breadcrumb-item active">Add New</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3 border-0">
                <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Add New Author</h5>
            </div>
            <div class="card-body p-4">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Live preview -->
                    <div class="text-center mb-4">
                        <div class="preview-avatar mx-auto" id="previewAvatar">
                            <span id="previewInitials">?</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0" id="previewName">Enter name to preview</p>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label fw-semibold">
                            First Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="FirstName" class="form-control" id="firstName"
                               placeholder="e.g. Jane" autocomplete="off" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label fw-semibold">
                            Last Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="LastName" class="form-control" id="lastName"
                               placeholder="e.g. Austen" autocomplete="off" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Photo" class="form-label fw-semibold">Photo URL
                            <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input asp-for="Photo" class="form-control" id="photoUrl"
                               placeholder="https://…/photo.jpg" />
                        <div id="photoPreviewWrap" class="mt-2 d-none">
                            <img id="photoPreview" src="" alt="Preview"
                                 class="rounded-circle border" width="60" height="60"
                                 style="object-fit:cover" />
                        </div>
                        <span asp-validation-for="Photo" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-check-lg me-1"></i>Create Author
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-x me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const fn       = document.getElementById('firstName');
    const ln       = document.getElementById('lastName');
    const initials = document.getElementById('previewInitials');
    const nameEl   = document.getElementById('previewName');
    const photoIn  = document.getElementById('photoUrl');
    const photoWrap= document.getElementById('photoPreviewWrap');
    const photoImg = document.getElementById('photoPreview');

    function updatePreview() {
        const f = fn.value.trim(), l = ln.value.trim();
        initials.textContent = (f[0] || '?').toUpperCase() + (l[0] || '').toUpperCase();
        nameEl.textContent   = (f || l) ? `${f} ${l}`.trim() : 'Enter name to preview';
    }
    fn.addEventListener('input', updatePreview);
    ln.addEventListener('input', updatePreview);

    photoIn.addEventListener('input', () => {
        const url = photoIn.value.trim();
        if (url) {
            photoImg.src = url;
            photoWrap.classList.remove('d-none');
        } else {
            photoWrap.classList.add('d-none');
        }
    });
</script>
}

<style>
.preview-avatar {
    width:70px; height:70px; border-radius:50%;
    background:var(--bs-primary); display:flex;
    align-items:center; justify-content:center;
}
.preview-avatar span { color:#fff; font-size:1.5rem; font-weight:700; }
</style>
