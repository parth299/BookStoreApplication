@model AuthorRequestDTO
@{
    ViewData["Title"] = "Edit Author";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Authors</a></li>
        <li class="breadcrumb-item active">Edit #@ViewBag.AuthorId</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow border-0">
            <div class="card-header bg-warning text-dark py-3 border-0">
                <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Author</h5>
            </div>
            <div class="card-body p-4">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <form asp-action="Edit" asp-route-id="@ViewBag.AuthorId" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Live preview -->
                    <div class="text-center mb-4">
                        <div class="preview-avatar mx-auto" id="previewAvatar">
                            <span id="previewInitials">
                                @(Model.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "?")@(Model.LastName?.Length > 0 ? Model.LastName[0].ToString().ToUpper() : "")
                            </span>
                        </div>
                        <p class="text-muted small mt-2 mb-0" id="previewName">@Model.FirstName @Model.LastName</p>
                        <span class="badge bg-secondary mt-1">ID: @ViewBag.AuthorId</span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label fw-semibold">
                            First Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="FirstName" class="form-control" id="firstName" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label fw-semibold">
                            Last Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="LastName" class="form-control" id="lastName" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Photo" class="form-label fw-semibold">Photo URL
                            <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input asp-for="Photo" class="form-control" id="photoUrl" />
                        @if (!string.IsNullOrEmpty(Model.Photo))
                        {
                            <div class="mt-2">
                                <img id="photoPreview" src="@Model.Photo" alt="Current photo"
                                     class="rounded-circle border" width="60" height="60"
                                     style="object-fit:cover" />
                                <small class="text-muted ms-2">Current photo</small>
                            </div>
                        }
                        else
                        {
                            <div class="mt-2 d-none" id="photoPreviewWrap">
                                <img id="photoPreview" src="" class="rounded-circle border"
                                     width="60" height="60" style="object-fit:cover" />
                            </div>
                        }
                        <span asp-validation-for="Photo" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill text-dark fw-semibold">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Detail" asp-route-id="@ViewBag.AuthorId"
                           class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const fn       = document.getElementById('firstName');
    const ln       = document.getElementById('lastName');
    const initials = document.getElementById('previewInitials');
    const nameEl   = document.getElementById('previewName');
    const photoIn  = document.getElementById('photoUrl');
    const photoImg = document.getElementById('photoPreview');

    function updatePreview() {
        const f = fn.value.trim(), l = ln.value.trim();
        initials.textContent = (f[0] || '?').toUpperCase() + (l[0] || '').toUpperCase();
        nameEl.textContent   = (f || l) ? `${f} ${l}`.trim() : '';
    }
    fn.addEventListener('input', updatePreview);
    ln.addEventListener('input', updatePreview);

    photoIn?.addEventListener('input', () => {
        if (photoImg) photoImg.src = photoIn.value.trim();
    });
</script>
}

<style>
.preview-avatar {
    width:70px; height:70px; border-radius:50%;
    background:var(--bs-warning); display:flex;
    align-items:center; justify-content:center;
}
.preview-avatar span { color:#000; font-size:1.5rem; font-weight:700; }
</style>
