@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager") || User.IsInRole("StoreOwner");
    var canManage = isAdmin || isManager;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BookVerse</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <aside class="sidebar d-none d-lg-flex flex-column">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">BV</span>
                <span>
                    <strong>BookVerse</strong>
                    <small>Premium MVC Storefront</small>
                </span>
            </a>

            <nav class="side-nav">
                <a asp-controller="Home" asp-action="Index">🏠 Home</a>
                <a asp-controller="Books" asp-action="Index">📚 Books</a>
                <a asp-controller="Authors" asp-action="Index">✍️ Authors</a>
                <a asp-controller="Reviews" asp-action="Index">⭐ Reviews</a>

                @if (!isLoggedIn)
                {
                    <a asp-controller="Reviews" asp-action="Create">💬 Guest Review</a>
                }

                @if (isLoggedIn && !canManage)
                {
                    <a asp-controller="Cart" asp-action="Index">🛒 My Cart</a>
                }

                @if (canManage)
                {
                    <div class="nav-section-title">Management</div>
                    <a asp-controller="Categories" asp-action="Index">🏷️ Categories</a>
                    <a asp-controller="Publishers" asp-action="Index">🏢 Publishers</a>
                    <a asp-controller="Inventory" asp-action="Index">📦 Inventory</a>
                }

                @if (isAdmin)
                {
                    <a asp-controller="UserAdmin" asp-action="Index">🛡️ Users & Roles</a>
                }
            </nav>

            <div class="sidebar-card mt-auto">
                <div class="tiny-label">API CONNECTED</div>
                <div class="fw-semibold">MVC → Web API</div>
                <small>Role-aware UI, guest reviews, and no public role selection.</small>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <button class="btn btn-soft d-lg-none"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileNav"
                        type="button">
                    ☰
                </button>

                <form class="top-search d-none d-md-flex"
                      asp-controller="Books"
                      asp-action="Index"
                      method="get">
                    <span>🔎</span>
                    <input name="title" placeholder="Search books, ISBN, editions..." />
                </form>

                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (!isLoggedIn)
                    {
                        <a class="btn btn-gold"
                           asp-controller="Reviews"
                           asp-action="Create">
                            Write Guest Review
                        </a>
                    }

                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main class="content-wrap">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm rounded-4">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-4">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNav">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">BookVerse</h5>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <div class="offcanvas-body">
            <nav class="side-nav mobile">
                <a asp-controller="Home" asp-action="Index">🏠 Home</a>
                <a asp-controller="Books" asp-action="Index">📚 Books</a>
                <a asp-controller="Authors" asp-action="Index">✍️ Authors</a>
                <a asp-controller="Reviews" asp-action="Index">⭐ Reviews</a>

                @if (!isLoggedIn)
                {
                    <a asp-controller="Reviews" asp-action="Create">💬 Guest Review</a>
                }

                @if (isLoggedIn && !canManage)
                {
                    <a asp-controller="Cart" asp-action="Index">🛒 My Cart</a>
                }

                @if (canManage)
                {
                    <a asp-controller="Categories" asp-action="Index">🏷️ Categories</a>
                    <a asp-controller="Publishers" asp-action="Index">🏢 Publishers</a>
                    <a asp-controller="Inventory" asp-action="Index">📦 Inventory</a>
                }

                @if (isAdmin)
                {
                    <a asp-controller="UserAdmin" asp-action="Index">🛡️ Users & Roles</a>
                }
            </nav>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>