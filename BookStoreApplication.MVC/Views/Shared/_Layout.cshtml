<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookStore </title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="app-nav">
            <a class="app-brand" asp-area="" asp-controller="Book" asp-action="Index">BookStore</a>
            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label="Toggle navigation">
                Menu
            </button>
            <ul class="app-nav__links" data-nav-menu>
                <li>
                    <a asp-area="" asp-controller="Book" asp-action="Index">Books</a>
                </li>
                @if (User.IsInRole("Admin") || User.IsInRole("StoreOwner"))
                {
                    <li>
                        <a asp-area="" asp-controller="Publisher" asp-action="Index">Publishers</a>
                    </li>
                }
                @* <li>
                    <a asp-area="" asp-controller="Publisher" asp-action="Index">Publishers</a>
                </li> *@
            </ul>
        </nav>
    </header>
    <div class="page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="page-shell">
            &copy; 2026 - BookStore Catalog
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
