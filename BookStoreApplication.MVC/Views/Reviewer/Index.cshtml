@model List<ReviewerDto>
@{
    ViewData["Title"] = "Reviewers";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Reviewers</h2>
    <a class="btn btn-primary" asp-action="Create">Create Reviewer</a>
</div>
@if (ViewBag.ErrorMessage != null) { <div class="alert alert-warning">@ViewBag.ErrorMessage</div> }
<table class="table table-striped table-bordered bg-white">
    <thead><tr><th>Reviewer ID</th><th>Name</th><th>Employed By</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ReviewerId</td>
            <td>@item.Name</td>
            <td>@item.EmployedBy</td>
            <td><a asp-controller="Review" asp-action="Reviewer" asp-route-reviewerId="@item.ReviewerId">View Reviews</a></td>
        </tr>
    }
    </tbody>
</table>
