@model BookCatalogIndexViewModel
@{
    ViewData["Title"] = "Books";
}

<section class="catalog-heading">
    <div>
        <p class="catalog-kicker">Catalog Management</p>
        <h1>Books</h1>
    </div>
    @if (Model.CanManageCatalog)
    {
        <a class="catalog-button catalog-button--primary" asp-action="Create">Add Book</a>
    }
</section>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="catalog-alert catalog-alert--success">@Model.Notice</div>
}

<div class="catalog-shell">
    <aside class="filter-panel" id="bookFilterPanel">
        <div class="filter-panel__header">
            <h2>Filter</h2>
            <button class="catalog-button catalog-button--small catalog-button--ghost filter-mobile-control" type="button" data-filter-toggle>Close</button>
        </div>
        <form asp-action="Filter" method="get" class="catalog-filter">
            <div class="field-group">
                <label asp-for="Filter.Title" class="form-label">Title</label>
                <input asp-for="Filter.Title" name="Title" class="form-input" placeholder="Search by title" />
            </div>
            <div class="field-group">
                <label asp-for="Filter.PublisherId" class="form-label">Publisher</label>
                <select asp-for="Filter.PublisherId" name="PublisherId" class="form-input">
                    <option value="">All publishers</option>
                    @foreach (var publisher in Model.Publishers)
                    {
                        <option value="@publisher.PublisherId">@publisher.Name</option>
                    }
                </select>
            </div>
            <div class="field-group">
                <label asp-for="Filter.Category" class="form-label">Category</label>
                <select asp-for="Filter.Category" name="Category" class="form-input">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CatId">@category.CatDescription</option>
                    }
                </select>
            </div>
            <button class="catalog-button catalog-button--dark catalog-button--full" type="submit">Apply Filters</button>
            <a class="catalog-link catalog-link--block" asp-action="Index">Clear</a>
        </form>
    </aside>

    <section class="catalog-results">
        <div class="catalog-toolbar">
            <form asp-action="Index" method="get" class="catalog-search">
                <input name="title" value="@Model.Filter.Title" class="form-input" placeholder="Search books by title" />
                <button class="catalog-button catalog-button--ghost" type="submit">Search</button>
            </form>
            <button class="catalog-button catalog-button--ghost filter-mobile-control" type="button" data-filter-toggle>Filters</button>
        </div>

        @if (Model.Books.Count == 0)
        {
            <div class="empty-state">No books found.</div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var book in Model.Books)
                {
                    var categoryName = book.Category.HasValue
                        ? Model.Categories.FirstOrDefault(category => category.CatId == book.Category.Value)?.CatDescription
                        : null;

                    <article class="book-card">
                        <div class="book-card__body">
                            <h2>@book.Title</h2>
                            <p>@(string.IsNullOrWhiteSpace(book.Description) ? "No description added yet." : book.Description)</p>
                            <div class="book-meta">
                                <span>@(book.PublisherName ?? "Unknown publisher")</span>
                                @if (!string.IsNullOrWhiteSpace(categoryName))
                                {
                                    <span>@categoryName</span>
                                }
                            </div>
                        </div>
                        <div class="book-card__actions">
                            <a class="catalog-button catalog-button--small catalog-button--ghost-primary" asp-action="Detail" asp-route-isbn="@book.Isbn">Details</a>
                            @if (Model.CanManageCatalog)
                            {
                                <a class="catalog-button catalog-button--small catalog-button--ghost" asp-action="Edit" asp-route-isbn="@book.Isbn">Edit</a>
                            }
                            <a class="catalog-button catalog-button--small catalog-button--ghost-success" asp-controller="Review" asp-action="Create" asp-route-isbn="@book.Isbn">Add Review</a>
                            <a class="catalog-button catalog-button--small catalog-button--success" asp-controller="ShoppingCart" asp-action="Add" asp-route-isbn="@book.Isbn">Add to Cart</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
