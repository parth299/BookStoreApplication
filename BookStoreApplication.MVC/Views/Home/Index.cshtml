@{
    ViewData["Title"] = "Home Page";
}

<div class="py-5 animate-fade-in">
    <div class="glass-card text-center py-5">
        <h1 class="display-4 fw-bold mb-3">Welcome to BookStore</h1>
        <p class="lead text-muted mb-4">Discover your next favorite book in our curated collection.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="#" class="btn btn-primary px-4 py-2">Browse Books</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary px-4 py-2">Join Now</a>
            }
        </div>
    </div>
</div>
