@model object
@{
    ViewData["Title"] = "Average Rating";
}

<h1>Average Book Rating</h1>

<form asp-action="Index" method="post" class="input-group mb-4 col-lg-6">
    @Html.AntiForgeryToken()
    <input name="isbn" value="@ViewBag.Isbn" class="form-control" placeholder="Enter ISBN" />
    <button class="btn btn-primary" type="submit">Get Average Rating</button>
</form>

@if (Model != null)
{
    @await Html.PartialAsync("_ObjectTable", Model)
}
