@model CategoryViewModel

@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="card-title">Category #@Model.CatId</h4>
        <p class="card-text"><strong>Description:</strong> @Model.CatDescription</p>
    </div>
</div>

<div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CatId">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>
