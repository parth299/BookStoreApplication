@model CategoryFormModel
@{
    ViewData["Title"] = "Edit Category";
}

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <h1 class="page-title">Edit Category</h1>
                <div class="card">
                    <div class="card-body p-4">
                        @{
    int categoryId = Context.Request.RouteValues["id"] != null ? Convert.ToInt32(Context.Request.RouteValues["id"]) : 0;
}
<form asp-action="Edit" asp-route-id="@categoryId" method="post">
                            <div class="mb-3">
                                <label asp-for="CatDescription" class="form-label">Description</label>
                                <textarea asp-for="CatDescription" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="CatDescription" class="text-danger small"></span>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Update Category</button>
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
