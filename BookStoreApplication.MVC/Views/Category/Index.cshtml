@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-tags-fill me-2 text-success"></i>Categories</h2>
        <small class="text-muted">Manage book categories</small>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> Add Category
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Client-side filter -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-funnel text-muted"></i></span>
            <input id="filterInput" type="text" class="form-control border-start-0"
                   placeholder="Filter categories…" autocomplete="off" />
        </div>
    </div>
</div>

<!-- Category List -->
@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-tag fs-1 d-block mb-2"></i>
        <p>No categories yet. <a asp-action="Create">Create one?</a></p>
    </div>
}
else
{
    <!-- Stats bar -->
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="badge bg-success fs-6 px-3 py-2">
            <i class="bi bi-collection me-1"></i>
            <span id="visibleCount">@Model.Count</span> categories
        </span>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3" id="catGrid">
        @{
            // Cycle through soft colors for variety
            var colors = new[] { "primary","success","warning","info","danger","secondary" };
            int ci = 0;
        }
        @foreach (var cat in Model)
        {
            var color = colors[ci++ % colors.Length];
            <div class="col cat-row" data-name="@cat.CatDescription.ToLower()">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body d-flex align-items-center gap-3 py-3">
                        <div class="cat-icon bg-@color bg-opacity-10 text-@color">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="mb-0 fw-semibold text-truncate cat-name">@cat.CatDescription</h6>
                            <small class="text-muted">ID: @cat.CatId</small>
                        </div>
                        <a asp-action="Edit" asp-route-id="@cat.CatId"
                           class="btn btn-sm btn-outline-@color" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="noResults" class="text-center py-4 text-muted d-none">
        <i class="bi bi-search fs-2 d-block mb-2"></i>
        No categories match your filter.
    </div>
}

@section Scripts {
<script>
    const filterInput   = document.getElementById('filterInput');
    const rows          = document.querySelectorAll('.cat-row');
    const noResults     = document.getElementById('noResults');
    const visibleCount  = document.getElementById('visibleCount');

    filterInput?.addEventListener('input', () => {
        const q = filterInput.value.toLowerCase().trim();
        let visible = 0;
        rows.forEach(row => {
            const match = row.dataset.name.includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        if (visibleCount) visibleCount.textContent = visible;
        if (noResults) noResults.classList.toggle('d-none', visible > 0);
    });
</script>
}

<style>
.hover-card { transition: transform .15s, box-shadow .15s; }
.hover-card:hover { transform: translateY(-2px); box-shadow: 0 .4rem 1rem rgba(0,0,0,.1) !important; }
.cat-icon { width:44px; height:44px; border-radius:10px;
            display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
</style>
