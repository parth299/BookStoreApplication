@model IEnumerable<BookStoreApplication.MVC.DTOs.Inventory.CartItemDto>
@{ ViewData["Title"]="Cart"; var items = Model?.ToList() ?? new List<BookStoreApplication.MVC.DTOs.Inventory.CartItemDto>(); }
<section class="page-hero"><div class="position-relative d-flex justify-content-between align-items-end flex-wrap gap-3"><div><h1>Shopping cart.</h1><p>Demo cart flow powered by your ShoppingCart API endpoints.</p></div><a asp-action="Add" asp-route-userId="@ViewBag.UserId" class="btn btn-light rounded-pill px-4">Add Item</a></div></section>
<div class="table-card"><table class="table"><thead><tr><th>User</th><th>ISBN</th><th>Quantity</th><th class="text-end">Action</th></tr></thead><tbody>@foreach(var i in items){<tr><td>@i.UserId</td><td><strong>@i.ISBN</strong></td><td>@i.Quantity</td><td class="text-end"><form asp-action="Remove" method="post" asp-route-userId="@i.UserId" asp-route-isbn="@i.ISBN">@Html.AntiForgeryToken()<button class="btn btn-soft btn-sm text-danger">Remove</button></form></td></tr>}</tbody></table></div>
@if(items.Any()){<form asp-action="Clear" method="post" asp-route-userId="@ViewBag.UserId" class="mt-3">@Html.AntiForgeryToken()<button class="btn btn-outline-danger">Clear Cart</button></form>}
