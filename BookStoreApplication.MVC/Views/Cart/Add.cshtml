@model BookStoreApplication.MVC.DTOs.Inventory.CartItemDto
@{ ViewData["Title"]="Add to Cart"; }
<section class="page-hero"><div class="position-relative"><h1>Add cart item.</h1><p>Select a book from the API-backed dropdown.</p></div></section>
<div class="form-card"><form method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="col-md-4"><label asp-for="UserId" class="form-label">User ID</label><input asp-for="UserId" class="form-control"/></div><div class="col-md-5"><label asp-for="ISBN" class="form-label">Book</label><select asp-for="ISBN" asp-items="ViewBag.Books" class="form-select"><option value="">Select book</option></select></div><div class="col-md-3"><label asp-for="Quantity" class="form-label">Quantity</label><input asp-for="Quantity" class="form-control" min="1"/></div><div class="col-12"><button class="btn btn-primary">Add to Cart</button> <a asp-action="Index" class="btn btn-soft">Cancel</a></div></form></div>
